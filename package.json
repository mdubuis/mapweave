{
  "name": "fantasy-map-generator",
  "productName": "Mapweave",
  "version": "1.152.2",
  "description": "Mapweave is a worldbuilding platform — a generated fantasy map and a cross-linked lore wiki in one app.",
  "homepage": "https://github.com/mdubuis/mapweave#readme",
  "bugs": {
    "url": "https://github.com/mdubuis/mapweave/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdubuis/mapweave.git"
  },
  "license": "MIT",
  "author": "mdubuis",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/pwa-precache.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:scripts": "node --test scripts/*.test.mjs",
    "lint": "biome check --write",
    "audit-ids": "node scripts/audit-id-collisions.mjs",
    "sync-version": "node scripts/sync-version.js",
    "stamp-assets": "node scripts/stamp-assets.js",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint && node scripts/sync-version.js --stage && node scripts/stamp-assets.js --stage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@playwright/test": "^1.57.0",
    "@types/d3": "^7.4.3",
    "@types/delaunator": "^5.0.3",
    "@types/leaflet": "^1.9.22",
    "@types/lineclip": "^2.0.0",
    "@types/node": "^25.0.10",
    "@types/polylabel": "^1.1.3",
    "@types/three": "^0.184.1",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.0.18",
    "jsdom": "^29.1.1",
    "playwright": "^1.57.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "alea": "^1.0.1",
    "d3": "^7.9.0",
    "delaunator": "^5.0.1",
    "driver.js": "^1.4.0",
    "leaflet": "^1.9.4",
    "lineclip": "^2.0.0",
    "polylabel": "^2.0.1",
    "quill": "^2.0.3",
    "three": "^0.184.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
